{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git rebase*)",
      "Bash(git pull --rebase*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(supabase db push*)",
      "Bash(supabase link*)",
      "Bash(supabase config push*)",
      "Bash(supabase db reset --linked*)",
      "Bash(supabase db reset * --linked*)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase link*)",
      "Bash(npx supabase config push*)",
      "Bash(pnpm dlx supabase db push*)",
      "Bash(pnpm dlx supabase link*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(pnpm exec supabase link*)",
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(vercel promote*)",
      "Bash(vercel rollback*)",
      "Bash(vercel env *)",
      "Bash(npx vercel --prod*)",
      "Bash(npx vercel * --prod*)",
      "Bash(npx vercel env *)",
      "Bash(pnpm dlx vercel --prod*)",
      "Bash(pnpm dlx vercel * --prod*)",
      "Bash(pnpm dlx vercel env *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.preview)",
      "Read(.env.test)"
    ]
  }
}
