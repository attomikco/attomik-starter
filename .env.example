# Supabase — Project Settings → API Keys. Placeholders only; copy to
# .env.local (git-ignored) and fill in real values. Never commit credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Resend — server-only key for app-sent email (workspace invitations).
# Sending-only key restricted to your verified domain. Never NEXT_PUBLIC_.
RESEND_API_KEY=re_your_sending_key_here
# Sender for app email (must be on a Resend-verified domain)
APP_EMAIL_FROM="Attomik Starter <auth@email.attomik.co>"
