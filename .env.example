# ─── Required · client-safe (inlined into the browser bundle) ───────────
# Supabase project URL and PUBLISHABLE key (Project Settings → API Keys).
# These are public by design; RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ─── Required for team invitations · SERVER-ONLY (never NEXT_PUBLIC_) ───
# Sending-only Resend API key restricted to your verified sending domain.
RESEND_API_KEY=re_your_sending_key_here
# Sender for app email; must be on the Resend-verified domain.
APP_EMAIL_FROM="Your App <auth@mail.yourdomain.com>"

# ─── Not app env vars ───────────────────────────────────────────────────
# The Supabase SMTP password is passed only at config-push time:
#   SMTP_PASS=<resend key> supabase config push
# The service-role key is never used by the application.
#
# Copy this file to .env.local (git-ignored). Never commit real values.
