#!/usr/bin/env bash
# Pre-push guard (versioned; `prepare` points core.hooksPath here on install).
# A push is refused unless typecheck and the unit tests pass — as standalone
# commands, never piped, so no exit status can be masked.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: pnpm typecheck"
pnpm typecheck
echo "pre-push: pnpm test"
pnpm test

# Migration guard (docs/SUPABASE.md): compares local migrations to the LINKED
# project's, so it stays opt-in — `git config hooks.checkMigrations true`
# once a project's migration history is in sync.
if [ "$(git config --get hooks.checkMigrations || true)" = "true" ]; then
  echo "pre-push: migrations pushed?"
  node scripts/check-migrations-pushed.ts
fi
